# Server-only PostgreSQL connection for Our Places. Keep this value private.
# Use a dedicated database and account, separate from other apps on the VPS.
# With no DATABASE_URL, development runs the local browser preview; production
# keeps the private pages locked instead of exposing that preview publicly.
DATABASE_URL=

# Optional: choose a map/place provider when the adapter is implemented.
# Supported planned values: google, mapbox, openstreetmap
NEXT_PUBLIC_PLACE_PROVIDER=openstreetmap
NEXT_PUBLIC_PLACE_API_KEY=

# Private photo folder, outside public/. Defaults to ./storage/photos.
# On the VPS use a directory owned by the service account, for example /var/lib/our-places/photos.
PHOTO_DIR=

# Saved OpenStreetMap road tiles for routes. Defaults to ./storage/roads and can be deleted at any time.
# On the VPS, for example /var/cache/our-places/roads.
ROAD_CACHE_DIR=
